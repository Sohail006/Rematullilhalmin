# PostgreSQL (Neon recommended): https://neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
AUTH_SECRET="change-me-to-a-long-random-secret-in-production"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@123"
NEXT_PUBLIC_SITE_URL="https://www.alsiratulmustaqeem.org.pk"

# Optional: Search Console / Bing verification codes (shown in <meta>)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Vercel Blob for production file uploads (required on Vercel)
# BLOB_READ_WRITE_TOKEN=

# Email via Resend (optional — notifications skipped if unset)
# RESEND_API_KEY=
# EMAIL_FROM="Al Sirat Ul Mustaqeem Foundation <noreply@alsiratulmustaqeem.org.pk>"
# ADMIN_NOTIFY_EMAIL="info@alsiratulmustaqeem.org.pk"
